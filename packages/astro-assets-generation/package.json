{
  "name": "@bearstudio/astro-assets-generation",
  "type": "module",
  "description": "Astro integration to generate assets with Takumi",
  "scripts": {
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "build": "tsup src/index.ts --format esm --dts --minify",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "astro": "5.16.12",
    "tsup": "8.5.1",
    "typescript": "latest"
  }
}
