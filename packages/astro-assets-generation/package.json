{
  "name": "@bearstudio/astro-assets-generation",
  "version": "0.1.0",
  "type": "module",
  "description": "Astro integration to generate assets with Takumi",
  "scripts": {
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "prebuild": "tsx src/scripts/bundle-emojis.ts",
    "build": "tsup src/index.ts --format esm --dts --minify",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepublishOnly": "pnpm build",
    "npm:publish": "pnpm publish --access public",
    "verdaccio:publish": "pnpm publish --registry http://localhost:4873 --no-git-checks",
    "verdaccio:unpublish": "npm unpublish @bearstudio/astro-assets-generation@$(node -p \"require('./package.json').version\") --registry http://localhost:4873 --force"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@takumi-rs/image-response": "0.65.0",
    "@twemoji/svg": "15.0.0",
    "ts-pattern": "5.9.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "20.0.0",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "latest"
  },
  "peerDependencies": {
    "astro": "^5.0.0"
  }
}
