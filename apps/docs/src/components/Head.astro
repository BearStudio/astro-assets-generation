---
// Starlight `Head` override: keeps the default head and adds a per-page
// Open Graph image generated by @bearstudio/astro-assets-generation
// (see src/pages/og/[...slug]/).
import Default from "@astrojs/starlight/components/Head.astro";
import { getEntry } from "astro:content";

// Starlight normalizes the root page id to "" while the `docs` collection
// (used to build the OG routes) keeps it as "index".
const slug = Astro.locals.starlightRoute.id || "index";
// Only pages backed by a real docs entry get an image (Starlight's built-in
// 404 page is synthetic and has no OG route).
const hasOgImage = Boolean(await getEntry("docs", slug));
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const ogImage = new URL(`${base}/og/${slug}/docs.png`, Astro.site);
---

<Default><slot /></Default>
{
  hasOgImage && (
    <>
      <meta property="og:image" content={ogImage} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:image" content={ogImage} />
    </>
  )
}
