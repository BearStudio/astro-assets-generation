---
import Layout from "@/layouts/Layout.astro";
import { getEntry, getCollection } from "astro:content";
import { render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
  }));
}

const { slug } = Astro.params;
const post = await getEntry("blog", slug);

if (!post) {
  return Astro.redirect("/404");
}

const { Content } = await render(post);

const ogImageUrl = new URL(`${slug}/assets/cover-author.png`, Astro.url);
---

<Layout title={post.data.title} ogImage={ogImageUrl.toString()}>
  <article class="max-w-3xl mx-auto px-4 py-8">
    <a href="/" class="inline-flex items-center text-sm text-gray-500 hover:text-gray-700 mb-6">
      ← Back to posts
    </a>

    <h1 class="text-4xl font-bold mb-4">{post.data.title}</h1>

    {
      post.data.description && (
        <p class="text-xl text-gray-600 mb-6">{post.data.description}</p>
      )
    }

    <div class="flex gap-2 mb-8">
      {
        post.data.tags?.map((tag) => (
          <span class="px-3 py-1 bg-indigo-100 text-indigo-800 rounded-full text-sm">
            #{tag}
          </span>
        ))
      }
    </div>

    <div class="prose prose-lg pb-12">
      <Content />
    </div>

    <div class="mt-8 pt-8 border-t border-gray-200">
      <p class="text-sm font-medium text-gray-500 mb-3">
        Generated OG image
        <span class="ml-2 text-xs bg-indigo-100 text-indigo-700 px-2 py-0.5 rounded-full">
          Generated on-demand
        </span>
      </p>
      <img
        src={ogImageUrl.toString()}
        alt={`OG image for ${post.data.title}`}
        class="w-full rounded-lg shadow-md border border-gray-200"
      />
      <p class="text-xs text-gray-400 mt-2 font-mono break-all">{ogImageUrl.pathname}</p>
    </div>
  </article>
</Layout>
